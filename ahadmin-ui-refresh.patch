+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  color: var(--teal-d);
+}
+.lp-how-steps {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
