+  min-width: 0;
+}
+@media (max-width: 1080px) {
+  .lp-services-flip-grid { gap: 1.5rem; }
+  .lp-flip-card-wrapper { flex-basis: calc((100% - 1.5rem) / 2); }
+}
+@media (max-width: 680px) {
+  .lp-services-flip-grid { gap: 1.25rem; }
+  .lp-flip-card-wrapper { flex-basis: 100%; }
+}
+
