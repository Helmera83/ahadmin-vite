+  margin: 1.1rem 0 0;
+  font-size: 0.74rem;
+  color: #7f93ab;
+  text-align: center;
+}
+
+/* ----- Services: center the last (short) row instead of leaving a gap ----- */
+.lp-services-flip-grid {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: center;
+  gap: 1.75rem;
+}
+.lp-flip-card-wrapper {
