+
+/* ==========================================================================
+   UI refresh: shared fixes and previously unstyled pieces
+   ========================================================================== */
+html { scroll-behavior: smooth; scroll-padding-top: 84px; }
+
+.lp-nav { gap: 1.25rem; }
+.lp-nav .lp-btn { color: #fff; }
