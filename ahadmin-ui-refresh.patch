+.lp-close .lp-wrap { display: block; }
+.lp-close-content {
+  display: flex;
+  flex-direction: row;
+  align-items: center;
+  justify-content: space-between;
+  gap: 2rem 3rem;
+  flex-wrap: wrap;
+}
+.lp-close-content-col { max-width: 36rem; }
+@media (max-width: 860px) {
+  .lp-close-content { flex-direction: column; align-items: flex-start; }
+}
+
+/* ----- Small type/spacing fixes ----- */
+.lp-how-head h2 { max-width: 44rem; }
+.lp-how-steps h3 { margin-bottom: 0.55rem; }
+.lp-pricing-title { max-width: none; }
+
+.lp-close::before {
+  background:
+    radial-gradient(60rem 24rem at 85% 0%, rgba(21, 158, 156, 0.22), transparent 60%),
+    linear-gradient(rgba(16, 34, 63, 0.95), rgba(16, 34, 63, 0.95)),
+    url('/office2.jpg') center / cover no-repeat;
+}
+@media (min-width: 861px) {
+  .lp-close-content { flex-wrap: nowrap; }
+  .lp-close-content-col { max-width: 34rem; }
+  .lp-close-actions { flex-shrink: 0; }
+}
+
+/* About: keep body copy on the darker part of the photo */
+.lp-about.lp-about-bg::before {
+  background-image:
+    linear-gradient(105deg, rgba(16, 34, 63, 0.97) 0%, rgba(16, 34, 63, 0.92) 55%, rgba(16, 34, 63, 0.5) 100%),
+    url('/office2.jpg');
+}
+@media (max-width: 860px) {
+  .lp-about.lp-about-bg::before {
+    background-image:
+      linear-gradient(to bottom, rgba(16, 34, 63, 0.95) 0%, rgba(16, 34, 63, 0.9) 100%),
+      url('/office2.jpg');
+  }
+}
+
+/* Header: keep brand + button on one row on small phones */
+.lp-head .lp-wrap { min-height: 68px; height: auto; flex-wrap: nowrap; gap: 1rem; }
+.lp-brand { min-width: 0; white-space: nowrap; }
+@media (max-width: 480px) {
+  .lp-head .lp-wrap { padding: 0 1rem; }
+  .lp-brand > span > span:last-child { font-size: 0.9rem !important; }
+  .lp-nav { gap: 0.75rem; }
+  .lp-nav .lp-btn { padding: 0.45rem 0.85rem !important; font-size: 0.92rem; white-space: nowrap; }
+}
+@media (max-width: 600px) {
+  .lp-matrix-val-cell::before { flex-basis: 8.5rem; }
+}
+
+/* keep "(optional)" inline with its label text */
+.lp-form label .opt { display: inline; margin-left: 0.25rem; }
+
+@media (max-width: 600px) {
+  .lp-head .lp-wrap {
+    flex-direction: row;
+    align-items: center;
+    justify-content: space-between;
+    padding-top: 0;
+    padding-bottom: 0;
+    min-height: 64px;
+  }
+  .lp-nav { width: auto; justify-content: flex-end; }
+}
